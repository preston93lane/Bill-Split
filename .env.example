# Free key from https://aistudio.google.com (Get API key). Used only by the
# server-side /api/parse-receipt function, never sent to the browser.
GEMINI_API_KEY=
# Optional: override the Gemini model used to read receipts.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional, for shared bills (friends claiming on their own phones). Vercel's
# Upstash for Redis integration sets these for you. Without them, local dev
# keeps shared bills in memory.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
